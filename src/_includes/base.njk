</head>

<body class="bg-mkt-canvas text-white antialiased">

    <a href="#main"
        class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-1/2 focus-visible:-translate-x-1/2 focus-visible:z-[999] focus-visible:px-6 focus-visible:py-3 focus-visible:bg-brand-500 focus-visible:text-white focus-visible:font-medium focus-visible:rounded-lg">Skip
        to main content</a>

    <!-- Navigation -->
    <header id="site-nav"
        class="fixed top-0 inset-x-0 z-50 h-[52px] transition-[background-color,border-color] duration-200 ease-[ease]">
        <div class="max-w-[1200px] mx-auto px-10 h-full flex justify-between items-center">

            <!-- Logo -->
            <a href="/" class="inline-flex h-[30px]" aria-label="Kinda Software – home">
                {% include "logos/kinda.svg" %}
            </a>

            <!-- Desktop nav -->
            <div class="hidden md:flex items-center gap-6">
                <a href="/#about"
                    class="text-[14px] font-medium text-white/55 hover:text-white transition-colors">About</a>
                <a href="/#projects"
                    class="text-[14px] font-medium text-white/55 hover:text-white transition-colors">Projects</a>
                <a href="/resources/"
                    class="text-[14px] font-medium text-white/55 hover:text-white transition-colors">Resources</a>
                <a href="/#contact"
                    class="inline-flex items-center h-8 px-[22px] bg-brand-700 text-white text-[14px] font-medium rounded-[8px] hover:bg-brand-900 transition-colors"
                    style="box-shadow: 0 0 24px rgba(4,120,87,0.25)">Get in Touch</a>
            </div>

            <!-- Mobile -->
            <div class="md:hidden flex items-center gap-5">
                <a href="/resources/" class="text-[13px] font-medium text-white/55">Resources</a>
                <a href="/#contact" class="text-[13px] font-medium text-brand-400">Get in Touch</a>
            </div>
        </div>
    </header>

    {{ content | safe }}

    <!-- Footer -->
    <footer class="py-12 border-t border-white/[0.08]">
        <div class="max-w-[1120px] mx-auto px-6 md:px-10">
            <div class="flex flex-col items-center gap-6 text-center">
                <div aria-hidden="true" class="inline-flex h-9">
                    {% include "logos/kinda.svg" %}
                </div>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="/#about" class="text-[13px] text-white/45 hover:text-white transition-colors">About</a>
                    <a href="/#projects"
                        class="text-[13px] text-white/45 hover:text-white transition-colors">Projects</a>
                    <a href="/resources/"
                        class="text-[13px] text-white/45 hover:text-white transition-colors">Resources</a>
                    <a href="/#contact" class="text-[13px] text-white/45 hover:text-white transition-colors">Contact</a>
                </div>
                <p class="text-[12px] text-white/45">&copy; 2026 Kinda Software. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Nav scroll effect
        const nav = document.getElementById('site-nav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 10) {
                nav.classList.add('nav-scrolled');
            } else {
                nav.classList.remove('nav-scrolled');
            }
        }, { passive: true });

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>

</body>

</html>
